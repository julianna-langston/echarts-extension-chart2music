{
  "name": "echarts-extension-chart2music",
  "version": "0.1.0",
  "description": "Apache ECharts extension for Chart2Music. Turns ECharts charts into music so blind users can hear data.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "generate-stories": "node scripts/generate-storybook-stories.cjs",
    "dev": "node scripts/generate-storybook-stories.cjs && storybook dev -p 6006",
    "build-storybook": "node scripts/generate-storybook-stories.cjs && storybook build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "echarts",
    "echarts-extension",
    "chart2music",
    "sonification",
    "accessibility",
    "a11y",
    "charts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianna-langston/echarts-extension-chart2music.git"
  },
  "bugs": {
    "url": "https://github.com/julianna-langston/echarts-extension-chart2music/issues"
  },
  "homepage": "https://github.com/julianna-langston/echarts-extension-chart2music#readme",
  "license": "MIT",
  "peerDependencies": {
    "echarts": ">=5.0.0 <7"
  },
  "dependencies": {
    "chart2music": "^1.20.0"
  },
  "devDependencies": {
    "@storybook/html-vite": "10.6.0",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "echarts": "^6.1.0",
    "storybook": "10.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
